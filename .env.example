# Shared PostgreSQL settings
DB_HOST=350_postgres
DB_PORT=5432
DB_USER=datahive_app
DB_PASSWORD=replace-with-a-long-random-local-password
DB_NAME=datahive_db

# JWT settings
JWT_SECRET=replace-with-at-least-32-random-characters

# RabbitMQ settings
RABBITMQ_USER=datahive
RABBITMQ_PASSWORD=replace-with-a-long-random-local-password
RABBITMQ_QUEUE=350_event_notifications

# Service ports
AUTH_SERVICE_PORT=5001
EVENT_SERVICE_PORT=5002

# Log directories inside Docker containers
LOGS_DIR=/app/logs
NOTIFICATION_LOGS_DIR=/app/notification_logs
